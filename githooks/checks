# One shell command per line, run by githooks/pre-push before a push that runs checks.
# These match the `checks` job in .github/workflows/ci.yml. The database test (npm run test:db)
# is CI-only: it needs a local Supabase, which needs Docker, and the machine this repo was
# scaffolded on has none (2026-09-29).
npm run lint
npm run format:check
npm run typecheck
npm run build
